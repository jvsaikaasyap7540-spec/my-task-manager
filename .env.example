# Database URL for SQLite
DATABASE_URL="file:./database/dayflow.sqlite"

# JWT Secret for authentication tokens
JWT_SECRET="dayflow_jwt_secure_secret_key_prod_2026"

# Port configuration (Dev server runs on 3000)
PORT=3000

# GEMINI_API_KEY: Optional runtime secrets
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# Google Identity Services: use the same OAuth Web Client ID on client and server
VITE_GOOGLE_CLIENT_ID="949229513055-o6hf7hmd9a1c818vg48u89fju3ln9a17.apps.googleusercontent.com"
GOOGLE_CLIENT_ID="949229513055-o6hf7hmd9a1c818vg48u89fju3ln9a17.apps.googleusercontent.com"

# Pending task email alerts (sent once after a task's end date if it is not completed)
TEAM_LEAD_EMAIL="team-lead@example.com"
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="smtp-user"
SMTP_PASSWORD="replace-with-smtp-password"
SMTP_FROM="dayflow@example.com"

