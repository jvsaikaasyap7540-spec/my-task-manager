{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "my-task-manager",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-06",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		],
		"not_found_handling": "single-page-application"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "dayflow-db",
			"database_id": "ad6ecd03-88df-40f8-9248-fd1c186d1ab7",
			"migrations_dir": "migrations"
		},
		{
			"binding": "y",
			"database_name": "dayflow-db",
			"database_id": "ad6ecd03-88df-40f8-9248-fd1c186d1ab7",
			"remote": true
		}
	]
}